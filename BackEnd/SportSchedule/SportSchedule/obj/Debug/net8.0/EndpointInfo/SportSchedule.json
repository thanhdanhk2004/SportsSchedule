{
  "openapi": "3.0.1",
  "info": {
    "title": "SportSchedule",
    "version": "1.0"
  },
  "paths": {
    "/fixture": {
      "get": {
        "tags": [
          "Fixture"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/fixture/{league_id}/{page}": {
      "get": {
        "tags": [
          "Fixture"
        ],
        "parameters": [
          {
            "name": "league_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/league": {
      "get": {
        "tags": [
          "League"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/player/{player_id}": {
      "get": {
        "tags": [
          "Player"
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/statistic/{match_id}": {
      "get": {
        "tags": [
          "StatisticControler"
        ],
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/register": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserDataTransferObject"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserDataTransferObject": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}